{
    "name": "demo-vite",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{json,css,scss,md,html}": "prettier --write"
    },
    "dependencies": {
        "@ant-design/icons": "^6.3.4",
        "ahooks": "^3.10.0",
        "antd": "^6.6.5",
        "axios": "^1.20.0",
        "classnames": "^2.5.1",
        "immer": "^11.1.21",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.18.4",
        "styled-components": "^6.5.3"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/js": "^10.0.1",
        "@types/mockjs": "^1.0.10",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "mockjs": "^1.1.0",
        "prettier": "^3.9.9",
        "sass": "1.77.8",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.3.0",
        "vite-plugin-mock": "^3.0.2"
    }
}
